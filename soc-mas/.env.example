# ── F5 AI Security (CalypsoAI) OpenAI-compatible proxy ──────────────────────
# Same inline-proxy wiring the agent-security-lab agents use. Fill these in to
# run against your tenant; every agent call is tagged with a per-agent
# x-cai-metadata-session-id header for BYOA / Agentic Fingerprints visibility.
CALYPSOAI_OPENAI_API_BASE=https://us1.calypsoai.app/openai/your-connection-name
CALYPSOAI_TOKEN=cai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CALYPSOAI_MODEL=gpt-4o-mini

# ── Mock mode ───────────────────────────────────────────────────────────────
# Leave the proxy vars blank, or set MOCK_MODE=1, to run with no backend: a
# deterministic brain drives the SAME in-process tools, so the OAuth-scope,
# capability, and A2A-card denials still fire. Guardrail blocking is only
# exercised in live mode (it happens at the real proxy).
# MOCK_MODE=1

# ── Distributed backend (wire to the real docker stack) ─────────────────────
# Set BACKEND=distributed to run the agents' real loops against the live lab:
# real Keycloak tokens, a real MCP SSE session (real capability + scope +
# Postgres), and a real A2A call to the Comms container. Enforcement is done by
# those services. Requires the CalypsoAI proxy vars above for the LLM.
# BACKEND=distributed

# Endpoints — defaults assume soc-mas runs INSIDE the lab's compose network
# (service DNS names). If you run soc-mas on the host instead, point these at
# the published ports: http://localhost:8000/sse, http://localhost:8080/...,
# http://localhost:9100
KEYCLOAK_ISSUER=http://keycloak:8080/realms/agent-lab
MCP_SERVER_URL=http://mcp-server:8000/sse
COMMS_A2A_URL=http://comms:9100

# Per-agent Keycloak client secrets. Defaults match the stock realm export;
# override only if you changed them (same var names the lab's compose uses).
# TRIAGE_OAUTH_CLIENT_SECRET=agent-triage-secret-change-me
# THREAT_INTEL_OAUTH_CLIENT_SECRET=agent-threat-intel-secret-change-me
# REMEDIATION_OAUTH_CLIENT_SECRET=agent-remediation-secret-change-me

# ── Option C1 (run the real agent containers) ───────────────────────────────
# Used by soc-mas/c1/compose.c1.yml. The orchestrator POSTs tasks to the
# shimmed agent services and calls Comms over real A2A; the agent containers do
# the real MCP/Keycloak/Postgres work. Set by the c1 compose file, shown here
# for reference / host runs:
# BACKEND=agents_http
# TRIAGE_URL=http://triage:9200
# THREAT_INTEL_URL=http://threat-intel:9200
# REMEDIATION_URL=http://remediation:9200
